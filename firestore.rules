rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated and matches uid
    function isAuthenticatedUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    
    // Users collection - only accessible by the authenticated user
    match /users/{userId} {
      allow read, write: if isAuthenticatedUser(userId);
      
      // Accounts subcollection
      match /accounts/{accountId} {
        allow read, write: if isAuthenticatedUser(userId);
        
        // Transactions subcollection
        match /transactions/{transactionId} {
          allow read, write: if isAuthenticatedUser(userId);
        }
      }
      
      // Statements subcollection
      match /statements/{statementId} {
        allow read, write: if isAuthenticatedUser(userId);
      }
      
      // Transfers subcollection
      match /transfers/{transferId} {
        allow read, write: if isAuthenticatedUser(userId);
      }
      
      // Bill Payments subcollection
      match /billPayments/{paymentId} {
        allow read, write: if isAuthenticatedUser(userId);
      }
      
      // Alerts subcollection
      match /alerts/{alertId} {
        allow read, write: if isAuthenticatedUser(userId);
      }
      
      // Budgets subcollection
      match /budgets/{budgetId} {
        allow read, write: if isAuthenticatedUser(userId);
      }
      
      // Cards subcollection
      match /cards/{cardId} {
        allow read, write: if isAuthenticatedUser(userId);
      }
      
      // Payees subcollection
      match /payees/{payeeId} {
        allow read, write: if isAuthenticatedUser(userId);
      }
      
      // Settings subcollection
      match /settings/{settingId} {
        allow read, write: if isAuthenticatedUser(userId);
      }
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
